# Copia questo file in .env.local e compila con i valori del tuo progetto Supabase
# (Project Settings → API, dopo aver creato il progetto in regione EU/Francoforte)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aggiunte il 19/09/2026 per app/api/cron/rifiuti-acegas/route.ts (Vercel
# Cron Job giornaliero, stazioni ecologiche di Trieste — v. il commento in
# testa a quel file). Vanno impostate anche come variabili d'ambiente del
# progetto Vercel (Settings → Environment Variables), non solo qui in
# locale — la route gira lì, non su GitHub Actions.
#
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY: stessi due valori già usati come
# GitHub Secrets per scripts/ingest-light.mjs (Project Settings → API →
# service_role — NON la chiave anon sopra, quella è limitata dalla RLS e
# non può scrivere).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CRON_SECRET: una stringa a caso generata da te (es. `openssl rand -hex 32`).
# Vercel aggiunge automaticamente l'header "Authorization: Bearer <valore>"
# alle chiamate del suo Cron Job quando questa variabile esiste nel
# progetto — la route la confronta per rifiutare chiunque altro conosca
# l'URL.
CRON_SECRET=

# OPENCHARGEMAP_API_KEY: chiave personale GRATUITA per il modulo "Colonnine
# elettriche" (03/10/2026, scripts/ingest-light.mjs). Si registra un account
# gratuito su openchargemap.org, poi si genera la chiave da
# openchargemap.org/site/developerinfo. Va impostata come GitHub Secret per
# il workflow di ingestione (stesso posto di SUPABASE_SERVICE_ROLE_KEY sopra)
# — non serve per `next dev`, quindi non è necessaria qui in locale a meno
# che non si voglia far girare scripts/ingest-light.mjs sul proprio computer.
# Se manca, solo quel modulo si salta con un avviso.
OPENCHARGEMAP_API_KEY=

# SITE_AUTH_USER / SITE_AUTH_PASSWORD / SITE_AUTH_SECRET (19/10/2026) —
# cancello d'ingresso con password davanti a tutto il sito, vedi lib/auth.ts
# e middleware.ts. Se mancanti, vale il fallback nel codice (utente "admin",
# password quella indicata dall'utente in chat, secret di sviluppo fisso) —
# il sito consegnato funziona subito anche senza configurare queste
# variabili, ma PRIMA DI UN USO REALE vanno impostate qui su Vercel
# (Settings → Environment Variables) con valori propri, specialmente
# SITE_AUTH_SECRET (una stringa a caso, es. `openssl rand -hex 32`): il
# fallback resta leggibile da chiunque abbia il codice sorgente.
SITE_AUTH_USER=
SITE_AUTH_PASSWORD=
SITE_AUTH_SECRET=

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_SECURE
# (24/11/2026) — modulo di contatto in /contatti (vedi lib/mailer.ts,
# app/api/contatti/route.ts,
# components/ContattiForm.tsx). A differenza di SITE_AUTH_* qui NON
# esiste un fallback nel codice: senza queste variabili il modulo
# risponde sempre con un errore di invio (gestito, non un crash) finché
# non vengono impostate qui su Vercel (Settings → Environment
# Variables) — sono le credenziali SMTP della casella info@monitor.fvg.it,
# di solito reperibili nel pannello email del provider del dominio
# (es. Topweb). SMTP_PORT di default 465 (SSL/TLS diretta); se il
# provider usa invece 587 (STARTTLS), impostare SMTP_PORT=587 e
# SMTP_SECURE=false. CONTATTI_EMAIL_DESTINATARIO è facoltativa: se
# assente il modulo spedisce a info@monitor.fvg.it (valore comunicato
# dall'utente), da impostare solo se in futuro cambia casella.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
CONTATTI_EMAIL_DESTINATARIO=
