# Copia questo file in .env.local e compila con i valori del tuo progetto Supabase
# (Project Settings → API, dopo aver creato il progetto in regione EU/Francoforte)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aggiunte il 19/09/2026 per app/api/cron/rifiuti-acegas/route.ts (Vercel
# Cron Job giornaliero, stazioni ecologiche di Trieste — v. il commento in
# testa a quel file). Vanno impostate anche come variabili d'ambiente del
# progetto Vercel (Settings → Environment Variables), non solo qui in
# locale — la route gira lì, non su GitHub Actions.
#
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY: stessi due valori già usati come
# GitHub Secrets per scripts/ingest-light.mjs (Project Settings → API →
# service_role — NON la chiave anon sopra, quella è limitata dalla RLS e
# non può scrivere).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CRON_SECRET: una stringa a caso generata da te (es. `openssl rand -hex 32`).
# Vercel aggiunge automaticamente l'header "Authorization: Bearer <valore>"
# alle chiamate del suo Cron Job quando questa variabile esiste nel
# progetto — la route la confronta per rifiutare chiunque altro conosca
# l'URL.
CRON_SECRET=

# OPENCHARGEMAP_API_KEY: chiave personale GRATUITA per il modulo "Colonnine
# elettriche" (03/10/2026, scripts/ingest-light.mjs). Si registra un account
# gratuito su openchargemap.org, poi si genera la chiave da
# openchargemap.org/site/developerinfo. Va impostata come GitHub Secret per
# il workflow di ingestione (stesso posto di SUPABASE_SERVICE_ROLE_KEY sopra)
# — non serve per `next dev`, quindi non è necessaria qui in locale a meno
# che non si voglia far girare scripts/ingest-light.mjs sul proprio computer.
# Se manca, solo quel modulo si salta con un avviso.
OPENCHARGEMAP_API_KEY=
